# ------------------------------------------------------------
# DDS Reformas — variáveis de ambiente (todas opcionais)
# Copie para .env.local em desenvolvimento ou configure na Vercel
# (Project Settings → Environment Variables).
# ------------------------------------------------------------

# Domínio definitivo do site, sem barra no final.
# Usado em canonical, Open Graph, sitemap, robots e dados estruturados.
# Sem ele, a Vercel usa automaticamente o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=

# Medição (opcional). Nada é carregado enquanto estiver vazio.
# Quando algum ID for preenchido, o visitante vê um aviso de consentimento
# e os scripts só são carregados após a autorização.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
